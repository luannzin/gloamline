{
  "name": "gloamline",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "bun run --cwd apps/client dev",
    "build": "bun run --cwd apps/client build",
    "check": "bun packages/world/check.ts",
    "typecheck": "tsc -p packages/world --noEmit && tsc -p apps/client --noEmit",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/bun": "^1.3.3",
    "typescript": "^7.0.2"
  }
}
